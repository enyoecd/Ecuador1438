/**
 * Worker: puerta1-ecuador1438
 *
 * Endpoints existentes (NO modificados):
 *   POST tipo=timbre   → notificación Telegram de timbre
 *   POST tipo=formulario → reenvío de formulario por Telegram
 *
 * Endpoints NUEVOS (cámara WebRTC):
 *   POST tipo=camara&accion=iniciar    → verifica sesión en KV, crea sesión Calls SFU, retorna token
 *   POST tipo=camara&accion=finalizar  → elimina sesión Calls SFU, borra KV
 *   GET  ?tipo=camara&accion=estado    → retorna si hay sesión activa (para polling del botón)
 *
 * Variables de entorno requeridas (ya existentes en el Worker):
 *   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID — existentes (no tocar)
 *
 * NUEVAS variables/bindings a agregar:
 *   Secret: CF_CALLS_APP_ID     — ID de la app Cloudflare Calls SFU
 *   Secret: CF_CALLS_APP_SECRET — Token de la app Cloudflare Calls SFU
 *   KV Binding: CAMERA_STATE    — Namespace KV para estado de sesión activa
 */

// ═══════════════════════════════════════════════════════════════
//  CONSTANTES
// ═══════════════════════════════════════════════════════════════
const CAMERA_KV_KEY = 'puerta1_camera_session';
const CAMERA_SESSION_TTL_SECONDS = 7200; // 2 horas máximo (auto-expire en KV)
const CALLS_API_BASE = 'https://rtc.live.cloudflare.com/v1/apps';

// ═══════════════════════════════════════════════════════════════
//  CORS HEADERS
// ═══════════════════════════════════════════════════════════════
function corsHeaders(origin) {
  return {
    'Access-Control-Allow-Origin': origin || '*',
    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
    'Access-Control-Max-Age': '86400',
  };
}

function jsonResponse(data, status, origin) {
  return new Response(JSON.stringify(data), {
    status: status || 200,
    headers: {
      'Content-Type': 'application/json',
      ...corsHeaders(origin),
    },
  });
}

// ═══════════════════════════════════════════════════════════════
//  CLOUDFLARE CALLS SFU — HELPERS
// ═══════════════════════════════════════════════════════════════

async function createCallsSession(appId, appSecret) {
  const url = `${CALLS_API_BASE}/${appId}/sessions/new`;
  const resp = await fetch(url, {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${appSecret}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({}),
  });
  if (!resp.ok) {
    const errText = await resp.text();
    throw new Error(`Calls API error ${resp.status}: ${errText}`);
  }
  return resp.json();
}

async function closeCallsSession(appId, appSecret, sessionId) {
  const url = `${CALLS_API_BASE}/${appId}/sessions/${sessionId}/close`;
  const resp = await fetch(url, {
    method: 'PUT',
    headers: {
      Authorization: `Bearer ${appSecret}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ sessionDescription: { type: 'unspecified' } }),
  });
  return resp.ok;
}

// ═══════════════════════════════════════════════════════════════
//  HANDLER DE CÁMARA
// ═══════════════════════════════════════════════════════════════

async function handleCamera(request, env, accion, origin) {
  const appId = env.CF_CALLS_APP_ID;
  const appSecret = env.CF_CALLS_APP_SECRET;
  const kv = env.CAMERA_STATE;

  // ── ESTADO (GET) ─────────────────────────────────────────────
  if (accion === 'estado') {
    if (!kv) return jsonResponse({ ocupado: false, kvNoConfigurado: true }, 200, origin);
    const raw = await kv.get(CAMERA_KV_KEY);
    if (!raw) return jsonResponse({ ocupado: false }, 200, origin);
    const session = JSON.parse(raw);
    const ahora = Date.now();
    if (session.expiresAt && ahora > session.expiresAt) {
      await kv.delete(CAMERA_KV_KEY);
      return jsonResponse({ ocupado: false }, 200, origin);
    }
    return jsonResponse({
      ocupado: true,
      iniciadoHace: Math.floor((ahora - session.startedAt) / 1000),
    }, 200, origin);
  }

  // ── INICIAR (POST) ───────────────────────────────────────────
  if (accion === 'iniciar') {
    if (!appId || !appSecret) {
      return jsonResponse({
        error: 'Cloudflare Calls no configurado. Agrega CF_CALLS_APP_ID y CF_CALLS_APP_SECRET como Secrets del Worker.',
      }, 503, origin);
    }
    if (!kv) {
      return jsonResponse({
        error: 'KV CAMERA_STATE no configurado. Agrega el binding KV al Worker.',
      }, 503, origin);
    }

    // Doble verificación anti-race: leer KV antes de crear sesión
    const raw = await kv.get(CAMERA_KV_KEY);
    if (raw) {
      const session = JSON.parse(raw);
      const ahora = Date.now();
      if (!session.expiresAt || ahora < session.expiresAt) {
        return jsonResponse({
          ocupado: true,
          mensaje: 'La cámara ya está siendo utilizada. Intenta de nuevo más tarde.',
          iniciadoHace: Math.floor((ahora - session.startedAt) / 1000),
        }, 409, origin);
      }
      await kv.delete(CAMERA_KV_KEY);
    }

    // Crear sesión en Cloudflare Calls SFU
    let callsSession;
    try {
      callsSession = await createCallsSession(appId, appSecret);
    } catch (err) {
      return jsonResponse({ error: `Error creando sesión de video: ${err.message}` }, 502, origin);
    }

    const ahora = Date.now();
    const sessionData = {
      sessionId: callsSession.sessionId,
      startedAt: ahora,
      expiresAt: ahora + CAMERA_SESSION_TTL_SECONDS * 1000,
    };

    await kv.put(CAMERA_KV_KEY, JSON.stringify(sessionData), {
      expirationTtl: CAMERA_SESSION_TTL_SECONDS,
    });

    return jsonResponse({
      ok: true,
      sessionId: callsSession.sessionId,
      appId: appId,
    }, 200, origin);
  }

  // ── FINALIZAR (POST) ─────────────────────────────────────────
  if (accion === 'finalizar') {
    if (!kv) return jsonResponse({ ok: true }, 200, origin);

    // Intentar leer sessionId del body JSON
    let sessionId = null;
    try {
      const body = await request.json();
      sessionId = body.sessionId;
    } catch (_) {}

    const raw = await kv.get(CAMERA_KV_KEY);
    if (raw) {
      const session = JSON.parse(raw);
      const sid = sessionId || session.sessionId;
      if (appId && appSecret && sid) {
        await closeCallsSession(appId, appSecret, sid).catch(() => {});
      }
      await kv.delete(CAMERA_KV_KEY);
    }

    return jsonResponse({ ok: true }, 200, origin);
  }

  return jsonResponse({ error: 'Acción no reconocida' }, 400, origin);
}

// ═══════════════════════════════════════════════════════════════
//  EXPORT PRINCIPAL
//  ─────────────────────────────────────────────────────────────
//  INSTRUCCIONES PARA INTEGRAR:
//  En tu Worker actual, DENTRO de tu función fetch() existente,
//  agrega este bloque ANTES del código de timbre/formulario:
//
//    if (tipo === 'camara') {
//      return handleCamera(request, env, accion, origin);
//    }
//
//  Y copia las funciones corsHeaders, jsonResponse,
//  createCallsSession, closeCallsSession y handleCamera
//  al inicio de tu Worker existente.
// ═══════════════════════════════════════════════════════════════

export default {
  async fetch(request, env, ctx) {
    const origin = request.headers.get('Origin') || '*';

    if (request.method === 'OPTIONS') {
      return new Response(null, { status: 204, headers: corsHeaders(origin) });
    }

    const url = new URL(request.url);
    let tipo = url.searchParams.get('tipo');
    let accion = url.searchParams.get('accion');

    // Leer parámetros de FormData (comportamiento existente del Worker)
    if (request.method === 'POST') {
      const contentType = request.headers.get('Content-Type') || '';
      if (contentType.includes('multipart/form-data') || contentType.includes('application/x-www-form-urlencoded')) {
        const fd = await request.formData().catch(() => null);
        if (fd) {
          tipo = tipo || fd.get('tipo');
          accion = accion || fd.get('accion');
          // Reatachamos fd al request simulado para handlers existentes
          request._formData = fd;
        }
      }
    }

    // ── NUEVO: Cámara ──────────────────────────────────────────
    if (tipo === 'camara') {
      return handleCamera(request, env, accion, origin);
    }

    // ── EXISTENTE: Timbre ──────────────────────────────────────
    // PEGA AQUI TU CÓDIGO DE TIMBRE EXISTENTE
    if (tipo === 'timbre') {
      // Tu código existente de timbre/Telegram va aquí
      return jsonResponse({ error: 'Reemplaza este bloque con tu código existente de timbre' }, 501, origin);
    }

    // ── EXISTENTE: Formulario ──────────────────────────────────
    // PEGA AQUI TU CÓDIGO DE FORMULARIO EXISTENTE
    if (tipo === 'formulario') {
      // Tu código existente de formulario/Telegram va aquí
      return jsonResponse({ error: 'Reemplaza este bloque con tu código existente de formulario' }, 501, origin);
    }

    return jsonResponse({ error: 'Solicitud no reconocida' }, 400, origin);
  },
};
